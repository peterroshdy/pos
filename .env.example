NODE_ENV=development
PORT=4100
DATABASE_PATH=./data/token-taste.db
# Optional development overrides. Normal Windows setup needs no .env file.
JWT_SECRET=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PIN=
APP_PORT=8080
BUSINESS_TIMEZONE=Africa/Cairo
CLOUD_ENROLLMENT_URL=https://157.173.194.66
CLOUD_RECEIVER_ENABLED=false
# Legacy central credentials only; normal installs receive credentials during pairing.
CLOUD_BRANCH_TOKENS={}
CLOUD_DEVICE_TOKENS={}
CLOUD_JWT_SECRET=replace-with-a-different-32-character-secret
CLOUD_ADMIN_PASSWORD=replace-with-a-different-strong-password
CLOUD_APP_PORT=8443
# Optional local printer/drawer bridge. The endpoint receives {command, branchId}.
CASH_DRAWER_COMMAND_URL=
CASH_DRAWER_COMMAND_TOKEN=
VITE_API_URL=/api
